{
  "name": "threefive-gomoku-server",
  "version": "3.0.0",
  "private": true,
  "description": "多人五子棋联机后端（Cloudflare Workers + 本地 Node 双实现，原生 WebSocket）",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:cf": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node test/logic.test.js && node test/e2e.js && node test/frontend.test.js",
    "test:worker": "E2E_BASE=http://127.0.0.1:8787 node test/e2e.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "wrangler": "^3.100.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
